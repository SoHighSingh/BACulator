// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider        = "prisma-client-js"
    previewFeatures = ["driverAdapters"]
}

datasource db {
    // Cloudflare D1 (SQLite). At runtime the client connects through the D1 driver adapter
    // (see src/server/db.ts); this url is only used by Prisma CLI tooling such as `migrate diff`.
    provider = "sqlite"
    url      = "file:./dev.db"
}

// Removed Post model

// Necessary for Next auth
model Account {
    id                       String  @id @default(cuid())
    userId                   String
    type                     String
    provider                 String
    providerAccountId        String
    refresh_token            String? // @db.Text
    access_token             String? // @db.Text
    expires_at               Int?
    token_type               String?
    scope                    String?
    id_token                 String? // @db.Text
    session_state            String?
    user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    refresh_token_expires_in Int?

    @@unique([provider, providerAccountId])
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
    id            String    @id @default(cuid())
    name          String?
    email         String?   @unique
    emailVerified DateTime?
    image         String?
    accounts      Account[]
    sessions      Session[]
    weight        Float?    // User's weight in kg
    sex           String?   // User's sex ("male" or "female")
    tabs          Tab[]
}

model Tab {
  id         String   @id @default(cuid())
  name       String
  createdAt  DateTime @default(now())
  finishedAt DateTime?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  drinks     Drink[]
}

model VerificationToken {
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
}

model Drink {
  id         String   @id @default(cuid())
  tab        Tab      @relation(fields: [tabId], references: [id], onDelete: Cascade)
  tabId      String
  standards  Float    // number of standard drinks
  finishedAt DateTime // time when finished drinking
}
