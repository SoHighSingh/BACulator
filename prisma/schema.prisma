// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider        = "prisma-client-js"
    previewFeatures = ["driverAdapters"]
}

datasource db {
    // Cloudflare D1 (SQLite). At runtime the client connects through the D1 driver adapter
    // (see src/server/db.ts); this url is only used by Prisma CLI tooling such as `migrate diff`.
    provider = "sqlite"
    url      = "file:./dev.db"
}

// Removed Post model

// Necessary for Next auth
model Account {
    id                       String  @id @default(cuid())
    userId                   String
    type                     String
    provider                 String
    providerAccountId        String
    refresh_token            String? // @db.Text
    access_token             String? // @db.Text
    expires_at               Int?
    token_type               String?
    scope                    String?
    id_token                 String? // @db.Text
    session_state            String?
    user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    refresh_token_expires_in Int?

    @@unique([provider, providerAccountId])
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
    id            String    @id @default(cuid())
    name          String?
    email         String?   @unique
    emailVerified DateTime?
    image         String?
    accounts      Account[]
    sessions      Session[]
    weight        Float?    // User's weight in kg
    sex           String?   // User's sex ("male" or "female")
    tabs          Tab[]
}

// At most one open tab (finishedAt null) per user: a partial unique index in migrations/0004_offline_adds.sql
// (Prisma can't express it here).
model Tab {
  id         String   @id @default(cuid())
  name       String
  createdAt  DateTime @default(now())
  finishedAt DateTime?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  drinks     Drink[]
}

model VerificationToken {
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
}

model Drink {
  id         String   @id @default(cuid())
  tab        Tab      @relation(fields: [tabId], references: [id], onDelete: Cascade)
  tabId      String
  standards  Float    // number of standard drinks (what the user confirmed)
  finishedAt DateTime // time when finished drinking
  name       String?  // e.g. "Victoria Bitter" or "2× VB + Tequila" for a multi-drink entry
  volumeMl   Float?   // volume of one serve (total volume for a multi-drink entry)
  abv        Float?   // % alcohol by volume (ethanol-weighted for a multi-drink entry)
  count      Float?   // number of serves
  source     String?  // recent | cache | catalog | ai | manual | edited
  confidence Float?   // 0-1, from the parser
  rawText    String?  // what the user typed; normalised to look up recents
  clientId   String?  @unique // id the phone gave the drink, so an offline add replayed twice is saved once

  @@index([tabId])
}

// Curated drink catalog (seeded from src/lib/drinks/catalog.ts by migrations/0003_seed_catalog.sql)
model DrinkCatalog {
  id        String  @id
  name      String
  brand     String?
  category  String  // beer | cider | wine | sparkling | fortified | spirit | liqueur | rtd | cocktail | soju_sake | non_alcoholic
  abv       Float
  serveMl   Float   // default serve when the user gives no size
  aliases   String  // JSON array of lower-case phrases
  isMixer   Boolean @default(false)
  sourceUrl String?
}

// Australian serve sizes (schooner, pot, SA pint, ...)
model ServeSize {
  id              String  @id
  name            String
  kind            String  // measure | container
  volumeMl        Float
  categoryMl      String? // JSON map of category -> ml for containers
  impliesCategory String?
  aliases         String  // JSON array
  sourceUrl       String?
}

// Successful AI parses, keyed by normalised text, so each phrase only costs one AI call
model ParseCache {
  key       String   @id // normalised drink text
  version   Int      // PARSER_VERSION at the time of the parse
  items     String   // JSON ParsedItem[]
  hits      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
