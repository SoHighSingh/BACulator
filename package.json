{
  "name": "baculator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "shoot": "node scripts/shoot.mjs",
    "build": "next build --webpack",
    "build:worker": "node scripts/check-env-files.js && opennextjs-cloudflare build && node scripts/check-env-files.js --built",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "check": "eslint . && tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply baculator --local",
    "db:migrate:remote": "wrangler d1 migrations apply baculator --remote",
    "db:migrations:sql": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script",
    "db:catalog-sql": "tsx scripts/build-catalog-sql.ts",
    "deploy": "npm run build:worker && opennextjs-cloudflare deploy",
    "dev": "next dev",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "postinstall": "prisma generate",
    "preview": "npm run build:worker && opennextjs-cloudflare preview",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval:drinks": "tsx scripts/eval-drinks.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@opennextjs/cloudflare": "^1.20.13",
    "@prisma/adapter-d1": "^6.12.0",
    "@prisma/client": "^6.5.0",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-slot": "^1.2.3",
    "@serwist/next": "^9.5.13",
    "@t3-oss/env-nextjs": "^0.12.0",
    "@tanstack/query-sync-storage-persister": "^5.83.0",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-query-persist-client": "^5.83.0",
    "@trpc/client": "^11.19.0",
    "@trpc/react-query": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.525.0",
    "next": "^16.4.2",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "superjson": "^2.2.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.0.15",
    "@types/node": "^20.14.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.23.0",
    "eslint-config-next": "^16.4.2",
    "playwright-core": "^1.56.1",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "prisma": "^6.5.0",
    "serwist": "^9.5.13",
    "tailwindcss": "^4.0.15",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.27.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.151.1"
  },
  "ct3aMetadata": {
    "initVersion": "7.39.3"
  },
  "packageManager": "npm@11.3.0",
  "overrides": {
    "@node-minify/core": {
      "glob": "^10.5.0"
    },
    "next": {
      "postcss": "^8.5.30"
    }
  }
}
