{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "baculator",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-06-01",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, must match the worker name (OpenNext caching)
			"binding": "WORKER_SELF_REFERENCE",
			"service": "baculator"
		}
	],
	// Workers AI: last-resort drink parser (free daily allocation). See src/lib/drinks/ai.ts
	"ai": {
		"binding": "AI",
		// Workers AI always runs remotely, also under `next dev`
		"remote": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "baculator",
			"database_id": "4e941b3a-156c-4e3a-ac10-bb9e10e294c5",
			"migrations_dir": "migrations"
		}
	]
}